# L30: generated by scripts/build-index.mjs at deploy time (derived from public/models/atlas.json)
/public/api/
workers/*/node_modules/

# L30 P3: generated by scripts/build-zh.mjs at deploy time (from scripts/zh-llm-cache.json + scripts/zh-wikidata.json)
/public/i18n/
# Transient work-lists for scripts/translate-zh.mjs, rewritten on every build-zh run.
/scripts/zh-missing.json
/scripts/zh-failed-batches.json
